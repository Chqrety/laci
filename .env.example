# ==============================================================================
# LACI DOSCOM - PRODUCTION CONFIGURATION (.env)
# ==============================================================================
# Catatan: File ini opsional. Jika dijalankan tanpa .env, Docker Compose sudah
# memiliki default fallback bawaan yang siap langsung jalan (zero-configuration).

# Port aplikasi publik (default: 80)
PORT=80

# URL Domain Publik Aplikasi
APP_URL=https://laci.doscom.org

# Database PostgreSQL
DB_USER=laci
DB_PASSWORD=laci_secret_pass
DB_NAME=laci_prod_db

# Upstream proxy internal Docker
VITE_API_URL=/api
BACKEND_URL=http://backend:8080

# Layanan SMTP Email (Opsional)
# Jika dikosongkan, token aktivasi dan reset password akan dicetak langsung di log container backend
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LACI DOSCOM <doscom.go@gmail.com>

# Data Akun Ketua Umum Perdana (Genesis Ketum)
INIT_KETUM_NIM=A11.2024.00000
INIT_KETUM_NAMA=Ketua Umum DOSCOM
INIT_KETUM_EMAIL=doscom.go@gmail.com
INIT_KETUM_USERNAME=ketum
